{
  "name": "dsh-coding-suite",
  "description": "Unified coding suite for DeepSeek Harness: engineering and product requirements skills, Pocket specs, interactive UI launcher, and todo progress guard.",
  "version": "0.2.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuqiangdede/dsh-coding-suite.git"
  },
  "type": "module",
  "scripts": {
    "pack": "npm pack",
    "verify:bundle": "node scripts/verify-client-bundle.mjs",
    "test:spec-action": "node --experimental-transform-types --test --test-isolation=none tests/spec-action.node.test.mjs"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./todo-progress-guard": {
      "types": "./lib/types/todo-progress-guard.d.ts",
      "default": "./lib/todo-progress-guard.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "files": [
    "assets/**/*",
    "lib/**/*",
    "scripts/**/*",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-brand": ">=0.2.0 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.18.0",
    "yaml": "^2.4.2",
    "zod": "4.4.3"
  }
}
